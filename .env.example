AI_PROVIDER=openai_compatible
AI_BASE_URL=https://your-relay.example.com/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL=gpt-4o-mini
ZJ_DB_PATH=/app/server/data/zj_koc_v3.dat

# 抖音开放平台视频搜索（也可在系统设置中填写）
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_DEVICE_ID=

# 后台自动任务：每天固定抓取通用热点，再按当前项目生成 AI 推荐分析
AUTO_TASK_ENABLED=1
AUTO_TASK_TIME=07:00
AUTO_TASK_BOOTSTRAP=1
